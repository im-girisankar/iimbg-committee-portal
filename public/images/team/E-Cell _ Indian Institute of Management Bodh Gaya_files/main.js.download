/**
 * IIM Bodh Gaya – Main JavaScript
 * @package iimbg
 */

(function () {
  'use strict';

  /* ============================================================
     LOADER
     ============================================================ */
  window.addEventListener('load', function () {
    setTimeout(function () {
      var loader = document.getElementById('loader');
      if (loader) loader.classList.add('hidden');
    }, 600);
    setupReveal();
  });

  /* ============================================================
     NAVBAR SCROLL
     ============================================================ */
  var header = document.getElementById('site-header');
  window.addEventListener('scroll', function () {
    if (header) {
      header.classList.toggle('scrolled', window.scrollY > 60);
    }
  }, { passive: true });

  /* ============================================================
     MOBILE POPUP MENU
     ============================================================ */
  window.iimbgToggleMenu = function () {
    var menu = document.getElementById('popupMenu');
    if (!menu) return;
    var isOpen = menu.classList.toggle('open');
    menu.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    document.body.style.overflow = isOpen ? 'hidden' : '';
  };

  /* ============================================================
     HERO SLIDER
     ============================================================ */
  var currentSlide = 0;
  var slideTitles = [
    {
      title: 'Creating <em>Mindful</em><br>Leaders for a<br>Sustainable Future',
      sub: 'Nurturing socially responsible managers with global perspective, ethical grounding and analytical excellence.'
    },
    {
      title: 'Excellence in<br><em>Management</em><br>Education',
      sub: 'A globally recognized business school committed to developing future-ready leaders.'
    },
    {
      title: 'Where Wisdom<br>Meets <em>World-Class</em><br>Academics',
      sub: 'Mentored by IIM Calcutta, building responsible leaders through rigour, resilience, and responsibility.'
    }
  ];

  function updateSlide() {
    var slides = document.querySelectorAll('.hero-slide');
    var dots   = document.querySelectorAll('.slide-dot');
    slides.forEach(function (s, i) { s.classList.toggle('active', i === currentSlide); });
    dots.forEach(function (d, i)   { d.classList.toggle('active', i === currentSlide); });

    var t       = slideTitles[currentSlide];
    var titleEl = document.getElementById('heroTitle');
    var subEl   = document.getElementById('heroSubtitle');
    if (titleEl && subEl && t) {
      titleEl.style.opacity = '0';
      titleEl.style.transform = 'translateY(20px)';
      subEl.style.opacity = '0';
      setTimeout(function () {
        titleEl.innerHTML = t.title;
        subEl.textContent = t.sub;
        titleEl.style.transition = 'all 0.6s';
        titleEl.style.opacity = '1';
        titleEl.style.transform = 'translateY(0)';
        subEl.style.transition = 'all 0.6s 0.2s';
        subEl.style.opacity = '1';
      }, 300);
    }
  }

  window.iimbgChangeSlide = function (dir) {
    var slides = document.querySelectorAll('.hero-slide');
    var total  = slides.length;
    if (!total) return;
    currentSlide = (currentSlide + dir + total) % total;
    updateSlide();
    resetSlideTimer();
  };

  window.iimbgGoSlide = function (n) {
    currentSlide = n;
    updateSlide();
    resetSlideTimer();
  };

  var slideTimer;
  function startSlideTimer() {
    slideTimer = setInterval(function () {
      iimbgChangeSlide(1);
    }, 6000);
  }
  function resetSlideTimer() {
    clearInterval(slideTimer);
    startSlideTimer();
  }

  if (document.querySelector('.hero-slide')) {
    startSlideTimer();
  }

  /* ============================================================
     SCROLL REVEAL
     ============================================================ */
  function setupReveal() {
    var els = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
    if (!els.length) return;

    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            obs.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      els.forEach(function (el) { obs.observe(el); });
    } else {
      els.forEach(function (el) { el.classList.add('visible'); });
    }
  }

  window.setupReveal = setupReveal;

  /* ============================================================
     FACULTY FILTER (archive-faculty page)
     ============================================================ */
  var currentFilter = 'All';
  var currentPage   = 1;

  window.iimbgSetFilter = function (dept, btn) {
    currentFilter = dept;
    currentPage   = 1;
    document.querySelectorAll('.faculty-filter-btn').forEach(function (b) {
      b.classList.remove('active');
    });
    if (btn) btn.classList.add('active');
    iimbgFetchFaculty();
  };

  window.iimbgFilterFaculty = function () {
    currentPage = 1;
    iimbgFetchFaculty();
  };

  window.iimbgChangePage = function (dir) {
    currentPage = Math.max(1, currentPage + dir);
    iimbgFetchFaculty();
  };

  window.iimbgGoToPage = function (p) {
    currentPage = p;
    iimbgFetchFaculty();
  };

  function iimbgFetchFaculty() {
    var grid   = document.getElementById('facultyGrid');
    var search = document.getElementById('facultySearch');
    if (!grid) return;

    // If AJAX available, use it; else filter on page
    if (typeof iimbgData !== 'undefined' && iimbgData.ajaxUrl) {
      var formData = new FormData();
      formData.append('action', 'iimbg_faculty_search');
      formData.append('nonce',  iimbgData.nonce);
      formData.append('search', search ? search.value : '');
      formData.append('dept',   currentFilter);
      formData.append('page',   currentPage);

      grid.style.opacity = '0.5';
      fetch(iimbgData.ajaxUrl, { method: 'POST', body: formData })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.success) {
            grid.innerHTML  = data.data.html;
            grid.style.opacity = '1';
            setupReveal();
          }
        })
        .catch(function () { grid.style.opacity = '1'; });
    }
  }

  /* ============================================================
     SMOOTH SCROLL FOR SIDEBAR LINKS
     ============================================================ */
  document.querySelectorAll('.sidebar-link[href^="#"]').forEach(function (link) {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        var offset = 110;
        var top    = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({ top: top, behavior: 'smooth' });
        document.querySelectorAll('.sidebar-link').forEach(function (l) { l.classList.remove('active'); });
        link.classList.add('active');
      }
    });
  });

  /* ============================================================
     ACTIVE SIDEBAR LINK ON SCROLL
     ============================================================ */
  var sections = document.querySelectorAll('[id]');
  if (sections.length && document.querySelector('.sidebar-link')) {
    window.addEventListener('scroll', function () {
      var scrollY = window.pageYOffset;
      sections.forEach(function (sec) {
        var top    = sec.offsetTop - 130;
        var bottom = top + sec.offsetHeight;
        if (scrollY >= top && scrollY < bottom) {
          document.querySelectorAll('.sidebar-link').forEach(function (l) {
            l.classList.toggle('active', l.getAttribute('href') === '#' + sec.id);
          });
        }
      });
    }, { passive: true });
  }

})();


  /* ============================================================
     STAFF FILTER (archive-staff page)
     ============================================================ */
  var staffFilter = 'All';
  var staffPage   = 1;
  var staffSearchTimer;

  window.iimbgStaffSetFilter = function (dept, btn) {
    staffFilter = dept;
    staffPage   = 1;
    document.querySelectorAll('.staff-filter-btn').forEach(function (b) {
      b.classList.remove('active');
    });
    if (btn) btn.classList.add('active');
    iimbgFetchStaff();
  };

  window.iimbgStaffSearch = function () {
    staffPage = 1;
    clearTimeout(staffSearchTimer);
    staffSearchTimer = setTimeout(iimbgFetchStaff, 300);
  };

  window.iimbgStaffChangePage = function (dir, total) {
    staffPage = Math.min(Math.max(1, staffPage + dir), total || 99);
    iimbgFetchStaff();
    window.scrollTo({ top: document.getElementById('staffGrid') ? document.getElementById('staffGrid').offsetTop - 120 : 0, behavior: 'smooth' });
  };

  window.iimbgStaffGoToPage = function (p) {
    staffPage = p;
    iimbgFetchStaff();
    window.scrollTo({ top: document.getElementById('staffGrid') ? document.getElementById('staffGrid').offsetTop - 120 : 0, behavior: 'smooth' });
  };

  function iimbgFetchStaff() {
    var grid   = document.getElementById('staffGrid');
    var search = document.getElementById('staffSearch');
    var pager  = document.getElementById('staffPagination');
    if (!grid) return;

    if (typeof iimbgData === 'undefined' || !iimbgData.ajaxUrl) return;

    var formData = new FormData();
    formData.append('action', 'iimbg_staff_search');
    formData.append('nonce',  iimbgData.nonce);
    formData.append('search', search ? search.value : '');
    formData.append('dept',   staffFilter);
    formData.append('page',   staffPage);

    grid.style.opacity = '0.4';
    grid.style.transition = 'opacity 0.2s';

    fetch(iimbgData.ajaxUrl, { method: 'POST', body: formData })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) return;
        grid.innerHTML     = data.data.html;
        grid.style.opacity = '1';
        setupReveal();

        // Update count badge
        var badge = document.getElementById('staffCount');
        if (badge) badge.textContent = data.data.found + ' member' + (data.data.found !== 1 ? 's' : '');

        // Rebuild pagination
        if (pager) {
          var total = parseInt(data.data.totalPages) || 1;
          var html  = '';
          if (total > 1) {
            html += '<button class="page-btn" onclick="iimbgStaffChangePage(-1,' + total + ')">‹</button>';
            for (var i = 1; i <= total; i++) {
              html += '<button class="page-btn' + (i === staffPage ? ' active' : '') + '" onclick="iimbgStaffGoToPage(' + i + ')">' + i + '</button>';
            }
            html += '<button class="page-btn" onclick="iimbgStaffChangePage(1,' + total + ')">›</button>';
          }
          pager.innerHTML = html;
        }
      })
      .catch(function () { grid.style.opacity = '1'; });
  }
