/* ── Smart Tabs – Public JS ────────────────────────────── */
(function () {
    'use strict';

    function initTabs(wrap) {
        var buttons     = [].slice.call(wrap.querySelectorAll('.st-nav-btn'));
        var panels      = [].slice.call(wrap.querySelectorAll('.st-panel'));
        var accHeaders  = [].slice.call(wrap.querySelectorAll('.st-accordion-header'));
        var mobileSelect = wrap.querySelector('.st-mobile-select');
        var mobileMode  = wrap.getAttribute('data-mobile') || 'accordion';
        var isVertical  = wrap.classList.contains('st-vertical');

        /* ── Activate a tab index ─────────────────────────── */
        function activate(index, skipAccordion) {
            /* Desktop nav buttons */
            buttons.forEach(function (btn, i) {
                var active = i === index;
                btn.classList.toggle('active', active);
                btn.setAttribute('aria-selected', active ? 'true' : 'false');
                btn.setAttribute('tabindex', active ? '0' : '-1');
            });

            /* Panels */
            panels.forEach(function (panel, i) {
                var active = i === index;
                panel.classList.toggle('active', active);
                if (active) panel.removeAttribute('hidden');
                else        panel.setAttribute('hidden', '');
            });

            /* Accordion headers sync */
            if (!skipAccordion) {
                accHeaders.forEach(function (hdr, i) {
                    var active = i === index;
                    hdr.classList.toggle('active', active);
                    hdr.setAttribute('aria-expanded', active ? 'true' : 'false');
                });
            }

            /* Dropdown sync */
            if (mobileSelect) mobileSelect.value = index;
        }

        /* ── Desktop nav click ────────────────────────────── */
        buttons.forEach(function (btn, i) {
            btn.addEventListener('click', function () { activate(i); });

            /* Arrow key navigation */
            btn.addEventListener('keydown', function (e) {
                var prev = isVertical ? 'ArrowUp'   : 'ArrowLeft';
                var next = isVertical ? 'ArrowDown' : 'ArrowRight';
                var target = -1;

                if      (e.key === next)  target = (i + 1) % buttons.length;
                else if (e.key === prev)  target = (i - 1 + buttons.length) % buttons.length;
                else if (e.key === 'Home') target = 0;
                else if (e.key === 'End')  target = buttons.length - 1;

                if (target !== -1) {
                    e.preventDefault();
                    activate(target);
                    buttons[target].focus();
                }
            });
        });

        /* ── Accordion headers (mobile) ───────────────────── */
        accHeaders.forEach(function (hdr, i) {
            hdr.addEventListener('click', function () {
                /* Toggle: clicking active header closes it on accordion */
                if (hdr.classList.contains('active')) {
                    hdr.classList.remove('active');
                    hdr.setAttribute('aria-expanded', 'false');
                    panels[i].classList.remove('active');
                    panels[i].setAttribute('hidden', '');
                } else {
                    activate(i, true);
                    /* Close all others */
                    accHeaders.forEach(function (h, j) {
                        if (j !== i) {
                            h.classList.remove('active');
                            h.setAttribute('aria-expanded', 'false');
                        }
                    });
                }
            });
            hdr.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); hdr.click(); }
            });
        });

        /* ── Dropdown (mobile) ────────────────────────────── */
        if (mobileSelect) {
            mobileSelect.addEventListener('change', function () {
                activate(parseInt(this.value, 10));
            });
        }

        /* ── Set initial active ───────────────────────────── */
        var initIndex = parseInt(wrap.getAttribute('data-active'), 10) || 0;
        if (initIndex >= buttons.length) initIndex = 0;
        activate(initIndex);
    }

    /* ── Init all tab groups ──────────────────────────────── */
    function init() {
        document.querySelectorAll('.smart-tabs-wrap').forEach(initTabs);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    /* API for page builders / dynamic content */
    window.SmartTabsInit = function (el) {
        if (el) initTabs(el);
        else init();
    };

}());
