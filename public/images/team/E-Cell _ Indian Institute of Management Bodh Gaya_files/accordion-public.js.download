/**
 * Accordion Blocks – Public JS
 * Vanilla JS, no dependencies, fully accessible (ARIA + keyboard)
 */
( function () {
    'use strict';

    function initAccordion( wrap ) {
        var multi   = wrap.dataset.multi === '1';
        var items   = Array.from( wrap.querySelectorAll( '.accb-item' ) );
        var buttons = Array.from( wrap.querySelectorAll( '.accb-trigger' ) );

        buttons.forEach( function ( btn ) {
            btn.addEventListener( 'click', function () {
                var item  = btn.closest( '.accb-item' );
                var panel = document.getElementById( btn.getAttribute( 'aria-controls' ) );
                var open  = item.classList.contains( 'accb-item--open' );

                if ( ! multi ) {
                    // Close all others first
                    items.forEach( function ( other ) {
                        if ( other !== item && other.classList.contains( 'accb-item--open' ) ) {
                            closeItem( other );
                        }
                    } );
                }

                if ( open ) {
                    closeItem( item );
                } else {
                    openItem( item, panel, btn );
                }
            } );

            // Keyboard: up/down arrows to move between triggers
            btn.addEventListener( 'keydown', function ( e ) {
                var idx = buttons.indexOf( btn );
                if ( e.key === 'ArrowDown' ) {
                    e.preventDefault();
                    if ( buttons[ idx + 1 ] ) buttons[ idx + 1 ].focus();
                }
                if ( e.key === 'ArrowUp' ) {
                    e.preventDefault();
                    if ( buttons[ idx - 1 ] ) buttons[ idx - 1 ].focus();
                }
                if ( e.key === 'Home' ) { e.preventDefault(); buttons[ 0 ].focus(); }
                if ( e.key === 'End'  ) { e.preventDefault(); buttons[ buttons.length - 1 ].focus(); }
            } );
        } );
    }

    function openItem( item, panel, btn ) {
        item.classList.add( 'accb-item--open' );
        btn.setAttribute( 'aria-expanded', 'true' );

        // Animate open
        panel.removeAttribute( 'hidden' );
        panel.classList.add( 'accb-animating' );
        var target = panel.scrollHeight;
        panel.style.height = '0px';
        // Force reflow
        panel.offsetHeight; // eslint-disable-line
        panel.style.transition = 'height .28s ease';
        panel.style.height = target + 'px';

        panel.addEventListener( 'transitionend', function end() {
            panel.removeEventListener( 'transitionend', end );
            panel.classList.remove( 'accb-animating' );
            panel.style.height = '';
            panel.style.transition = '';
        } );
    }

    function closeItem( item ) {
        var btn   = item.querySelector( '.accb-trigger' );
        var panel = document.getElementById( btn.getAttribute( 'aria-controls' ) );

        item.classList.remove( 'accb-item--open' );
        btn.setAttribute( 'aria-expanded', 'false' );

        // Animate close
        panel.classList.add( 'accb-animating' );
        panel.style.height = panel.scrollHeight + 'px';
        panel.offsetHeight; // eslint-disable-line
        panel.style.transition = 'height .25s ease';
        panel.style.height = '0px';

        panel.addEventListener( 'transitionend', function end() {
            panel.removeEventListener( 'transitionend', end );
            panel.classList.remove( 'accb-animating' );
            panel.style.height = '';
            panel.style.transition = '';
            panel.setAttribute( 'hidden', '' );
        } );
    }

    // Init all accordions on DOM ready
    document.addEventListener( 'DOMContentLoaded', function () {
        document.querySelectorAll( '.accb-wrap' ).forEach( initAccordion );
    } );

} )();
